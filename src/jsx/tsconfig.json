{
  "compilerOptions": {
    "noImplicitAny": true,
    "target": "es5",
    "module": "none",
    "noLib": true,
    "typeRoots": [
      "src/jsx/@types/libs/**/*",
      "src/jsx/@types/shared/**/*"
    ]
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "./*.ts",
    "./@types/libs/**/*",
    "./@types/shared/**/*"
  ]
}