{
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "allowJs": true,
    "module": "es2015",
    "moduleResolution": "node",
    "target": "es6",
    "experimentalDecorators": true,
    "typeRoots": [
      "node_modules/@types",
      "src/js/@types"
    ],
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "src/js/libs-js/**/*"
  ],
  "include": [
    "src/js/**/*"
  ]
}